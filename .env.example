# Copy to .env and fill in real values. Never commit .env itself.

VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
EVERLY_ASSISTANT_ID=

MONGODB_URI=

# MDR API — points at the mock service (src/mock-mdr-api/, npm run mock-mdr:dev)
# until the client's real API is available. Swap these two to go live.
MDR_API_BASE_URL=http://localhost:4000/api/everly
MDR_API_KEY=mock-api-key
MDR_ACCOUNT_ID=mock-account-1
MOCK_MDR_PORT=4000

